
# --- Overrides (intencionalmente pisados al theme) ---
shell-integration = zsh
background-opacity = 0.9
window-decoration = true
background-blur = false
config-file = "~/.local/share/moonarch/themes/current/ghostty.conf"
minimum-contrast = 1.5

# Colores override (difieren del theme base)
background = #11111b
foreground = #1A066F

cursor-style = bar
cursor-style-blink = true
font-family = CaskaydiaCode Mono Nerd Font
font-size = 15
font-style = bold
command = /bin/zsh
term = xterm-kitty
