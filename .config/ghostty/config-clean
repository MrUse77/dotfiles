
# --- Utility terminal overrides ---
shell-integration = zsh
background-opacity = 0.9
window-decoration = true
background-blur = false
config-file = "~/.local/share/moonarch/themes/current/ghostty.conf"
minimum-contrast = 1.5

# Ghostty applies later settings after config-file, so colors intentionally come
# only from the selected MoonArch fragment for this utility-terminal profile.

cursor-style = bar
cursor-style-blink = true
font-family = CaskaydiaCode Mono Nerd Font
font-size = 15
font-style = bold
command = /bin/zsh
term = xterm-kitty
