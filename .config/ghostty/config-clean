
# --- Utility terminal overrides ---
shell-integration = zsh
background-opacity = 0.9
window-decoration = true
background-blur = false
minimum-contrast = 1.5

# The default Ghostty profile already loads the selected MoonArch fragment, so
# this utility-terminal profile intentionally adds no theme or color settings.

cursor-style = bar
cursor-style-blink = true
font-family = CaskaydiaCode Mono Nerd Font
font-size = 15
font-style = bold
command = /bin/zsh
term = xterm-kitty
