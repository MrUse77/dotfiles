{
  // Markdownlint config for the repo
  "default": true,
  // Allow long lines — config docs often have long URLs and tables
  "MD013": false,
  // Allow multiple headings with same content (common in changelogs)
  "MD024": { "siblings_only": true },
  // Allow inline HTML (used for badges, details/summary, etc.)
  "MD033": false,
  // Allow bare URLs
  "MD034": false
}
