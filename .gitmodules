[submodule ".config/nvim"]
	path = home/.config/nvim
	url = https://github.com/MrUse77/Nvim-config.git
[submodule ".zsh_plugins/fzf-tab"]
	path = home/.zsh_plugins/fzf-tab
	url = https://github.com/Aloxaf/fzf-tab
[submodule ".zsh_plugins/zsh-autosuggestions"]
	path = home/.zsh_plugins/zsh-autosuggestions
	url = https://github.com/zsh-users/zsh-autosuggestions
[submodule ".zsh_plugins/zsh-history-substring-search"]
	path = home/.zsh_plugins/zsh-history-substring-search
	url = https://github.com/zsh-users/zsh-history-substring-search
[submodule ".zsh_plugins/zsh-syntax-highlighting"]
	path = home/.zsh_plugins/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting
[submodule ".config/hypr/plugins/split-monitor-workspaces"]
	path = home/.config/hypr/plugins/split-monitor-workspaces
	url = https://github.com/zjeffer/split-monitor-workspaces
