{
  "layer": "top", // Prioridad de renderizado
  "position": "top", // O "bottom", "left", "right"
  "mod": "dock",
  "height": 74, // Altura fija para evitar saltos de layout
  "exclusive": true, // Hyprland reservará este espacio

  // Módulos a cargar
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "wlr/taskbar",
    "tray",
    "custom/pacman"
  ],
  "modules-right": [
    "clock",
    "pulseaudio",
    "group/hardware",
    "custom/notification",
    "custom/power"
  ],

  // Configuración de módulos individuales
"hyprland/workspaces": {
  "format": "{icon}",

  "format-icons": {
    "urgent": "",
    "active": "●",
    "visible": "◉",
    "default": "○",
    "empty": "○"
  },

  "all-outputs": false,

  "on-scroll-up": "hyprctl dispatch split-cycleworkspaces -1",
  "on-scroll-down": "hyprctl dispatch split-cycleworkspaces +1"
},
  "tray": {
    "icon-size": 21,
    "spacing": 10
  },
  "clock": {
    "format": "{:%H:%M} ",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#7aa2f7'><b>{}</b></span>",
        "days": "{}",
        "weeks": "<span color='#414868'>W{}</span>",
        "weekdays": "{}",
        "today": "<span color='#f7768e'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "network": {
    // Ojo: Asume que tienes las Nerd Fonts instaladas para los iconos
    "format-wifi": "{essid} ({signalStrength}%) <span size='15pt' rise='-1500'>󰖩<span>",
    "format-ethernet": "{ipaddr}/{cidr} <span size='15pt' rise='-1500'>󰈀</span>",
    "tooltip-format": "{ifname} via {gwaddr}",
    "format-linked": "{ifname} (No IP)  ",
    "format-disconnected": "Disconnected ⚠ ",
    "format-alt": "{ifname}: {ipaddr}/{cidr}"
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol" // Asume que tienes pavucontrol instalado
  },
  "memory": {
    "interval": 10,
    "format": "SWAP: {swapUsed}G / {swapTotal}G\nRAM: {used}G / {total}G"
  },
  "cpu": {
    "interval": 5,
    "format": "{usage}% <span size='15pt' rise='-1500'></span>",
    "tooltip": false
  },
  "temperature": {
    // Zona térmica automática (thermal_zone0); se desactiva solo si no hay sensor.
    "critical-threshold": 80,
    "format": "{temperatureC}°C <span size='15pt' rise='-1500'>{icon}</span>",
    "format-icons": ["", "", ""]
  },

  "upower": {
    // Ojo: {icon} NO es placeholder valido en este modulo; el icono se muestra como imagen separada (icon-size).
    "format": "{percentage}%",
    "icon-size": 20,
    "hide-if-empty": true,
    "tooltip": true,
    "tooltip-spacing": 20,
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "group/hardware": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "children-class": "not-memory",
      "transition-left-to-right": false
    },
    "modules": [
      "cpu", // Un icono fijo que siempre se ve
      "temperature",
      "memory",
      "upower"
    ]
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 19,
   // "icon-theme": "Numix",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["Alacritty"]
  },
  "custom/power": {
    "format": "<span size='15pt'>⏻</span>", // Icono (necesitas una fuente como FontAwesome o NerdFonts)
    "tooltip": false,
    "on-click": "$HOME/.config/rofi/scripts/launch -show powermenu"
  },
  "custom/notification": {
    "tooltip": false,
    "format": "󰵅",
    "on-click": "$HOME/.config/eww/scripts/usrctl.sh" // Toggle del panel lateral
  },
      "custom/sep": {
        "format": "·", // Separador sutil
        "tooltip": false
  },
  "custom/pacman": {
    "format": "<span>  {}</span>",
    "interval": "once",
    "exec": "(checkupdates; paru -Qua) | wc -l",
    "on-click": "ghostty --config-file=$HOME/.config/ghostty/config-clean --title='UPDATING_SYSTEM' -e paru; read",
    "signal": 8,
    "tooltip-format": "{} updates available"
  },
  "custom/launcher": {
    "format": "",
    "on-click": "$HOME/.config/rofi/scripts/launch -show drun",
    "tooltip": false
  }
}
